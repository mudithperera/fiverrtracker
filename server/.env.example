# Copy to .env (in the repo root for docker compose) and fill in.
# The server refuses to boot if a required value is missing.

PORT=8787

# --- docker compose only -----------------------------------------------------
# The domain Caddy will get a TLS certificate for. Its A record must already
# point at this VPS, with ports 80 and 443 open.
API_DOMAIN=api.rankpeek.app
# Postgres password for the bundled database. Any long random string.
POSTGRES_PASSWORD=

# Public origin of THIS api, used to build the OAuth redirect URI.
# Must match the redirect URI registered in Google Cloud Console exactly.
PUBLIC_URL=https://api.rankpeek.app

# Neon (or any Postgres). Use the pooled connection string.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Signs session tokens and OAuth state. Rotating it signs everybody out.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Google Cloud Console -> Credentials -> OAuth client ID -> Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_YEARLY=price_...

# Comma-separated Chrome extension ids allowed to complete sign-in.
# Leave empty ONLY in development: empty accepts any well-formed extension id,
# which in production would let anyone sign users in against this backend.
ALLOWED_EXTENSION_IDS=

SESSION_DAYS=30

# --- tracking worker ---------------------------------------------------------
# Only needed by `npm run worker`. Leave the proxy blank to scan from the host's
# own IP, which is the right first step: find out whether Fiverr serves a headless
# browser at all before paying for residential bandwidth.
#
# Country targeting is encoded differently by every provider — proxy-cheap puts it
# in the username — so it is a template rather than a guess. {country} and
# {session} are substituted per scan; a stable {session} keeps one run on one IP.
# One endpoint per country. proxy-cheap sells a separate host:port:user:pass per
# location, so the country is *which endpoint you dial*, not a credential field.
# Any of these notations work — copy whichever your dashboard prints:
#   PROXY_AU=1.2.3.4:43118:username:password
#   PROXY_US=username:password@5.6.7.8:43118
#   PROXY_GB=http://username:password@9.10.11.12:43118
PROXY_NZ=
PROXY_AU=
PROXY_US=
PROXY_GB=
# Used only when a country has no endpoint of its own. A scan that quietly ran
# from the wrong country would be stored as that country's ranking, so the worker
# skips rather than falling back — this is for the one-shot test only.
PROXY_DEFAULT=

# Legacy alternative, for providers that put the country in the username instead
# of selling one endpoint per location.
PROXY_HOST=
PROXY_PORT=8080
PROXY_USERNAME_TEMPLATE=yourusername-country-{country}-session-{session}
PROXY_PASSWORD=

# Postgres for the integration tests. Without it those tests skip rather than fail.
TEST_DATABASE_URL=

# --- proxy gateway -----------------------------------------------------------
# The CONNECT relay customers point their browser at. It checks a short-lived
# token from /proxy/session, then dials the country's real proxy using the
# credentials above — which never leave this server.
#
# Disabled unless explicitly enabled: a relay listening by default is how open
# proxies happen. It only ever connects to Fiverr, on ports 80 and 443.
PROXY_GATEWAY_ENABLED=false
PROXY_GATEWAY_HOST=gateway.rankpeek.app
PROXY_GATEWAY_PORT=8443
