# Copy to .env and fill in. The server refuses to boot if a required value is missing.

PORT=8787

# Public origin of THIS api, used to build the OAuth redirect URI.
# Must match the redirect URI registered in Google Cloud Console exactly.
PUBLIC_URL=https://api.fiverrtracker.app

# Neon (or any Postgres). Use the pooled connection string.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Signs session tokens and OAuth state. Rotating it signs everybody out.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Google Cloud Console -> Credentials -> OAuth client ID -> Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_YEARLY=price_...

# Comma-separated Chrome extension ids allowed to complete sign-in.
# Leave empty ONLY in development: empty accepts any well-formed extension id,
# which in production would let anyone sign users in against this backend.
ALLOWED_EXTENSION_IDS=

SESSION_DAYS=30
